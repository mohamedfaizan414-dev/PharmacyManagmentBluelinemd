# ─────────────────────────────────────────────────────────────
# BluelineMD Pharmacy – environment
# Copy to .env (dev) or set in your host (Netlify / Docker build args)
# ─────────────────────────────────────────────────────────────

# Base URL of the BluelineMD backend (same one the admin panel uses).
# No trailing slash. Example: https://api.bluelinemd.com
VITE_API_ENDPOINT=

# true  = run fully on the built-in mock API (no backend needed – demo mode)
# false = talk to the real backend at VITE_API_ENDPOINT
# If VITE_API_ENDPOINT is empty the app always falls back to mock mode.
VITE_USE_MOCK=true

# Link back to the main admin panel (shown in the sidebar footer). Optional.
VITE_ADMIN_URL=

# Seconds between background refreshes of the prescription queue (0 = off)
VITE_QUEUE_POLL_SECONDS=30

# Days before expiry that a batch is flagged as "expiring soon"
VITE_EXPIRY_WARN_DAYS=90
